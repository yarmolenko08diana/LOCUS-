# ── Необязательный слой LLM ────────────────────────────────────────────────
# Продукт работает полностью без него: подбор, объяснения и roadmap строит
# собственный движок. LLM нужен только чтобы переписать текст диагностики
# более живым языком.
#
# Ключи в репозиторий не коммитятся: .env в .gitignore. В публичной статике
# ключ в любом случае нельзя держать на клиенте, поэтому VITE_LLM_ENDPOINT
# должен указывать на ваш серверный прокси, который сам хранит ключ.

VITE_LLM_ENABLED=false
VITE_LLM_ENDPOINT=
